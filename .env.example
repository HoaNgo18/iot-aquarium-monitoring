# Docker Compose
COMPOSE_PROJECT_NAME=iot-flood-monitoring

# MQTT
# Use 0.0.0.0 so an ESP32 on the same trusted LAN can reach the broker.
# Do not expose this development broker directly to the Internet.
MQTT_BIND_ADDRESS=0.0.0.0
MQTT_HOST_PORT=1883

# PostgreSQL
# The database port is bound to 127.0.0.1 by compose.yaml.
POSTGRES_HOST_PORT=5432
POSTGRES_DB=flood_monitoring
POSTGRES_USER=flood_app
POSTGRES_PASSWORD=change-me-for-local-development
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# Telemetry simulator (Docker Compose profile: simulator)
SIMULATOR_DEVICE_ID=node-001
SIMULATOR_SCENARIO=normal
PUBLISH_INTERVAL_SECONDS=5
SIMULATOR_MESSAGE_COUNT=0
SIMULATOR_SEED=2026

